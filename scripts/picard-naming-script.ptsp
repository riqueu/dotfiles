script: |
  $set(_artist,$rreplace($if2(%albumartist%,%artist%),[\\/:*?"<>|],_))
  $set(_album,$rreplace(%album%,[\\/:*?"<>|],_))
  $set(_title,$rreplace(%title%,[\\/:*?"<>|],_))

  %_artist%/
  [$left(%date%,4)] %_album%/
  $if($gt(%totaldiscs%,1),%discnumber%-,)$num(%tracknumber%,2) - %_title%
